<?xml version="1.0" encoding="utf-8"?>
<!-- Tabbed settings: a plain-view tab bar, one page visible at a time. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#070D1C"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/tab_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="8dp">

        <Button
            android:id="@+id/tab_picture"
            style="@style/TabEntry"
            android:text="@string/tab_picture" />

        <Button
            android:id="@+id/tab_port"
            style="@style/TabEntry"
            android:text="@string/tab_port" />

        <Button
            android:id="@+id/tab_controls"
            style="@style/TabEntry"
            android:text="@string/tab_controls" />

        <Button
            android:id="@+id/tab_files"
            style="@style/TabEntry"
            android:text="@string/tab_files" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="4dp"
        android:background="#243457" />

    <View
        android:layout_width="48dp"
        android:layout_height="2dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="4dp"
        android:background="#2CC4FF" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:id="@+id/page_picture"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/SectionHeading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/section_picture" />

                <TextView
                    android:id="@+id/resolution_label"
                    style="@style/SettingLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <SeekBar
                    android:id="@+id/resolution"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    style="@style/SettingHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/resolution_hint" />

                <TextView
                    android:id="@+id/render_scale_label"
                    style="@style/SettingLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <SeekBar
                    android:id="@+id/render_scale"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    style="@style/SettingHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/render_scale_hint" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/msaa"
                    style="@style/SettingSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/msaa" />

                <TextView
                    style="@style/SettingHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/msaa_hint" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/prefer60"
                    style="@style/SettingSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/prefer_60" />

                <TextView
                    style="@style/SettingHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/prefer_60_hint" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/widescreen"
                    style="@style/SettingSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/widescreen" />

                <TextView
                    style="@style/SettingHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/widescreen_hint" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/page_port"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/SectionHeading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/section_port" />

                <TextView
                    android:id="@+id/scene_scale_label"
                    style="@style/SettingLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <SeekBar
                    android:id="@+id/scene_scale"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    style="@style/SettingHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/scene_scale_hint" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/fsr"
                    style="@style/SettingSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/fsr" />

                <TextView
                    style="@style/SettingHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/fsr_hint" />

                <TextView
                    android:id="@+id/fsr_sharp_label"
                    style="@style/SettingLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <SeekBar
                    android:id="@+id/fsr_sharp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/cap30"
                    style="@style/SettingSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/cap30" />

                <TextView
                    style="@style/SettingHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/cap30_hint" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/low_memory"
                    style="@style/SettingSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/low_memory" />

                <TextView
                    style="@style/SettingHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/low_memory_hint" />

                <TextView
                    android:id="@+id/texture_label"
                    style="@style/SettingLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <SeekBar
                    android:id="@+id/texture_budget"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    style="@style/SettingHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/texture_hint" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/prewarm_all"
                    style="@style/SettingSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/prewarm_all" />

                <TextView
                    style="@style/SettingHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/prewarm_all_hint" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/stats"
                    style="@style/SettingSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/show_stats" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/page_controls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/SectionHeading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/section_sound" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/audio"
                    style="@style/SettingSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/audio_on" />

                <TextView
                    style="@style/SectionHeading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/section_controls" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/touch"
                    style="@style/SettingSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/touch_controls" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/gamepad"
                    style="@style/SettingSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/use_gamepad" />

                <TextView
                    style="@style/SettingHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/gamepad_hint" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/gamepad_p2"
                    style="@style/SettingSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/gamepad_p2" />

                <TextView
                    style="@style/SettingHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/gamepad_p2_hint" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/vibration"
                    style="@style/SettingSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/vibration" />

                <TextView
                    style="@style/SettingHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/edit_controls_where" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/page_files"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/SectionHeading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/section_files" />

                <TextView
                    android:id="@+id/paths"
                    style="@style/SettingHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#D6E2FF"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/storage_access"
                    style="@style/SettingHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#D6E2FF"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/grant_storage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/allow_storage" />

                <Button
                    android:id="@+id/change_folder"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/entry_select_folder" />

                <Button
                    android:id="@+id/forget"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/forget_install" />

                <TextView
                    style="@style/SettingHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/forget_explained" />

                <TextView
                    style="@style/SectionHeading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/section_storage" />

                <TextView
                    android:id="@+id/storage"
                    style="@style/SettingHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#D6E2FF"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/clear_shaders"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/clear_shaders" />

                <Button
                    android:id="@+id/clear_logs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/clear_logs" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
