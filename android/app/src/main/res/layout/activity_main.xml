<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher, laid out like the game's own main menu: a right-aligned
     list of entries on the left, the chosen entry's details on the right,
     the wordmark bottom-right. Landscape, one screen, nothing scrolls. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#070D1C">

    <com.pes2017.recomp.BackdropView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/version_tag"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:textColor="#8FA0C2"
            android:textSize="9sp"
            android:fontFamily="sans-serif"
            tools:text="0.0.2-alpha · build 16 · EUROPE" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:orientation="vertical">

                <Button
                    android:id="@+id/play"
                    style="@style/MenuEntry"
                    android:text="@string/play" android:textColor="#FFFFFF" android:textSize="15sp" />

                <Button
                    android:id="@+id/select_folder"
                    style="@style/MenuEntry"
                    android:text="@string/entry_select_folder" />

                <Button
                    android:id="@+id/install"
                    style="@style/MenuEntry"
                    android:text="@string/entry_install" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="2dp"
                    android:layout_marginStart="32dp"
                    android:background="#243457" />

                <Button
                    android:id="@+id/settings"
                    style="@style/MenuEntry"
                    android:text="@string/entry_settings" />

                <Button
                    android:id="@+id/driver"
                    style="@style/MenuEntry"
                    android:text="@string/graphics_driver" />

                <Button
                    android:id="@+id/log"
                    style="@style/MenuEntry"
                    android:text="@string/view_log" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="2dp"
                    android:layout_marginStart="32dp"
                    android:background="#243457" />

                <Button
                    android:id="@+id/entry_updates"
                    style="@style/MenuEntry"
                    android:text="@string/check_updates" />

                <Button
                    android:id="@+id/entry_quit"
                    style="@style/MenuEntry"
                    android:text="@string/quit_launcher" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/direct_launch_switch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="end"
                    android:text="@string/direct_launch"
                    android:textColor="#8FA0C2"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.15"
                android:layout_marginStart="8dp"
                android:orientation="vertical"
                android:paddingTop="2dp">

                <TextView
                    android:id="@+id/detail_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/detail_default_title"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.1" />

                <View
                    android:layout_width="48dp"
                    android:layout_height="2dp"
                    android:layout_marginTop="4dp"
                    android:background="#2CC4FF" />

                <TextView
                    android:id="@+id/detail_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:maxLines="6"
                    android:ellipsize="end"
                    android:text="@string/detail_default_text"
                    android:textColor="#B4C2E0"
                    android:textSize="11sp"
                    android:lineSpacingExtra="2dp"
                    android:fontFamily="sans-serif" />

                <TextView
                    android:id="@+id/status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:maxLines="5"
                    android:ellipsize="end"
                    android:textColor="#D6E2FF"
                    android:textSize="11sp"
                    android:lineSpacingExtra="2dp"
                    android:fontFamily="sans-serif" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/footer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="3"
                android:ellipsize="end"
                android:textColor="#8FA0C2"
                android:textSize="9sp"
                android:lineSpacingExtra="1dp"
                android:fontFamily="sans-serif" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/wordmark"
                    android:textColor="#EAF1FF"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.3" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/wordmark_year"
                    android:textColor="#2CC4FF"
                    android:textSize="20sp"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.12"
                    android:shadowColor="#0B5FD8"
                    android:shadowRadius="12"
                    android:shadowDx="0"
                    android:shadowDy="0" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="@string/disclaimer"
                    android:textColor="#6B7BA0"
                    android:textSize="7sp"
                    android:fontFamily="sans-serif" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
